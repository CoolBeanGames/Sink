<Window x:Class="Sink.DuplicateWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Find duplicates" Width="680" Height="650" MinHeight="480" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#161A22">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="26,24,26,16"><TextBlock Text="LIBRARY TOOLS" Foreground="#8B7CFF" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="Find duplicates" FontSize="25" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="Preview matches and choose exactly which copies to remove." Foreground="#858C9B" FontSize="12" Margin="0,5,0,0"/></StackPanel>
        <Border Grid.Row="1" Margin="26,0,26,16" Background="#101319" CornerRadius="9" Padding="4"><StackPanel Orientation="Horizontal"><RadioButton x:Name="FileNameMode" Content="File name" GroupName="Mode" IsChecked="True" Checked="Mode_Checked" Foreground="#E8E5FF" Background="#302B57" Padding="14,8"/><RadioButton x:Name="TrackNameMode" Content="Track name" GroupName="Mode" Checked="Mode_Checked" Foreground="#B6BCC8" Padding="14,8"/></StackPanel></Border>
        <Grid Grid.Row="2" Margin="26,0"><ListBox x:Name="CandidateList" Background="#12151C" BorderBrush="#292F3B" Foreground="#F4F6FA" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="10,7"/><Setter Property="IsHitTestVisible" Value="True"/></Style></ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding Remove}" Click="CandidateCheck_Click" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Track.Title}" FontWeight="SemiBold"/><TextBlock FontSize="10" Foreground="#7D8493"><Run Text="{Binding Track.Artist}"/><Run Text=" · "/><Run Text="{Binding Track.Album}"/><Run Text=" · "/><Run Text="{Binding Track.FileName}"/></TextBlock></StackPanel><TextBlock Grid.Column="2" Text="{Binding ActionText}" Foreground="#9B92D8" FontSize="10" VerticalAlignment="Center" Margin="10,0,0,0"/></Grid></DataTemplate></ListBox.ItemTemplate>
        </ListBox><StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="✓" Foreground="#72B98F" FontSize="30" HorizontalAlignment="Center"/><TextBlock Text="No duplicates found" FontSize="17" FontWeight="SemiBold" Margin="0,9,0,0"/><TextBlock Text="This library has no matching copies." Foreground="#7D8493" FontSize="11" Margin="0,4,0,0"/></StackPanel></Grid>
        <Border Grid.Row="3" BorderBrush="#292F3A" BorderThickness="0,1,0,0" Padding="26,15" Margin="0,16,0,0"><Grid><TextBlock x:Name="SelectedText" Foreground="#858C9B" FontSize="11" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Click="Cancel_Click" Padding="14,9" Margin="0,0,8,0" Background="#242A34" Foreground="#D1D5DD" BorderThickness="0"/><Button x:Name="RemoveButton" Content="Remove selected" Click="Remove_Click" Padding="14,9" Background="#642A36" Foreground="#FFE1E6" BorderThickness="0"/></StackPanel></Grid></Border>
    </Grid>
</Window>
