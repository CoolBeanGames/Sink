<Application x:Class="Sink.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <FontFamily x:Key="AppFont">Segoe UI Variable, Segoe UI</FontFamily>
        <SolidColorBrush x:Key="WorkspaceBrush" Color="#0B0D12"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#12151C"/>
        <SolidColorBrush x:Key="RaisedBrush" Color="#161A22"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#1D222C"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#262C38"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F4F6FA"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#858C9B"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#8B7CFF"/>
        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource WorkspaceBrush}"/>
        </Style>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#B6BCC8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#1D222C"/><Setter Property="Foreground" Value="#F4F6FA"/></Trigger>
                            <Trigger Property="Tag" Value="Active"><Setter TargetName="Chrome" Property="Background" Value="#302B57"/><Setter Property="Foreground" Value="#EEEAFE"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#1D222C"/>
            <Setter Property="Foreground" Value="#F4F6FA"/>
            <Setter Property="BorderBrush" Value="#363D4B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#E4E7EE"/>
            <Setter Property="Padding" Value="9,5"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#302B57"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#6B7280"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DialogTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Foreground" Value="#F4F6FA"/>
            <Setter Property="Background" Value="#0F1218"/>
            <Setter Property="BorderBrush" Value="#353C49"/>
            <Setter Property="CaretBrush" Value="#F4F6FA"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="IpodButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="250"/>
            <Setter Property="ToolTipService.ShowDuration" Value="20000"/>
            <Setter Property="ToolTipService.BetweenShowDelay" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#6559CE"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,9"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Application.Resources>
</Application>
