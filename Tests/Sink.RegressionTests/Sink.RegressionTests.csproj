<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Clickwheel" Version="0.1.1" />
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.13" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <Compile Include="../../Services/Ipod/*.cs" Link="Ipod/%(Filename)%(Extension)" />
    <Compile Include="../../Models/Track.cs" Link="Models/Track.cs" />
    <Compile Include="../../Models/ITitleTrimmable.cs" Link="Models/ITitleTrimmable.cs" />
  </ItemGroup>
</Project>
