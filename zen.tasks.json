          "kind": "task",
          "dueDate": null,
          "startedDate": null,
          "priority": null,
          "title": "Add multi-service music search to Downloads",
          "task": "Add a search box to the Downloads page that searches Spotify, YouTube, and Deezer. Show each result with Download, YT, Spotify, and Deezer actions. Download should choose the best available source in priority order Deezer, Spotify, then YouTube. Adding a result queues its link while allowing continued searching or returning to Downloads to start the queue. Selecting a result shows artwork and metadata in a lower details editor; users may override all populated metadata except track titles before queueing.",
          "tags": [
            "downloads",
            "music",
            "ui",
            "metadata",
            "in progress"
          ],
          "files": [],
          "customTypeId": null,
          "customValues": {},
          "requirements": [
            {
              "id": "7c958678d9804128a5f7c1cc12fd8d43",
              "index": 1,
              "text": "The Downloads page can search Spotify, YouTube, and Deezer and display unified results.",
              "isDone": true
            },
            {
              "id": "9b2073ebfda24e44a7c83dd7e6fe143f",
              "index": 2,
              "text": "Each result exposes Download, YT, Spotify, and Deezer actions; Download prefers Deezer, then Spotify, then YouTube.",
              "isDone": true
            },
            {
              "id": "e28c9a3df1cd43a9b24b4a57fe3c5158",
              "index": 3,
              "text": "Adding a result queues its chosen link without forcing downloads to start and the user can continue searching or return to the Downloads queue.",
              "isDone": true
            },
            {
              "id": "88f9329d3fbb45d995142868097c94fa",
              "index": 4,
              "text": "Selecting a result shows artwork and metadata below; all populated metadata except track titles can be overridden before queueing.",
              "isDone": true
            },
            {
