<Window x:Class="Sink.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Sink.Models"
        Title="Sink" Width="1260" Height="800" MinWidth="940" MinHeight="620" WindowStartupLocation="CenterScreen" Background="#0B0D12" AllowDrop="True" DragEnter="Window_DragEnter" DragOver="Window_DragOver" DragLeave="Window_DragLeave" Drop="Window_Drop">
    <Window.Resources>
        <Style x:Key="EyebrowStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="#7D8493"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#12151C"/><Setter Property="Foreground" Value="#747B8A"/><Setter Property="BorderBrush" Value="#262C38"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="Padding" Value="12,10"/><Setter Property="FontSize" Value="10"/></Style>
        <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,9"/><Setter Property="Foreground" Value="#BFC4CE"/><Setter Property="Background" Value="Transparent"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
        <Style TargetType="DataGridRow"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="#20252F"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="MinHeight" Value="48"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1B1F28"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#2B2850"/><Setter Property="Foreground" Value="#F4F6FA"/></Trigger></Style.Triggers></Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="82"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.RowSpan="2" Background="#12151C" BorderBrush="#262C38" BorderThickness="0,0,1,0" Padding="16,24">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="8,0,0,28"><Border Width="32" Height="32" CornerRadius="10" Background="#7568E5"><TextBlock Text="S" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Sink" FontSize="20" FontWeight="Bold" Margin="11,3,0,0"/></StackPanel>
                <StackPanel Grid.Row="1">
                    <Button x:Name="MusicHeaderButton" Content="LIBRARY" Tag="Active" Click="ShowMusicSource_Click" Style="{StaticResource SectionHeaderButtonStyle}"/>
                    <StackPanel x:Name="MusicNav">
                        <Button x:Name="ArtistsButton" Content="●    Artists" Tag="Artists" Click="Category_Click" Style="{StaticResource NavButtonStyle}"/>
                        <Button x:Name="AlbumsButton" Content="▣    Albums" Tag="Active" Click="Category_Click" Style="{StaticResource NavButtonStyle}"/>
                        <Button x:Name="GenresButton" Content="◇    Genres" Tag="Genres" Click="Category_Click" Style="{StaticResource NavButtonStyle}"/>
                        <Button x:Name="SongsButton" Content="♫    Songs" Tag="Songs" Click="Category_Click" Style="{StaticResource NavButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
                <Grid Grid.Row="2" Margin="10,24,4,8"><TextBlock Text="PLAYLISTS" Style="{StaticResource EyebrowStyle}"/><Button Content="＋" HorizontalAlignment="Right" Margin="0,-8,0,0" Foreground="#8B7CFF" Background="Transparent" BorderThickness="0" FontSize="20" Click="NewPlaylist_Click"/></Grid>
                <ListBox x:Name="PlaylistList" Grid.Row="3" Background="Transparent" BorderThickness="0" SelectionChanged="PlaylistList_SelectionChanged">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,2"/><Setter Property="Foreground" Value="#B6BCC8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="AllowDrop" Value="True"/><EventSetter Event="DragOver" Handler="PlaylistItem_DragOver"/><EventSetter Event="DragLeave" Handler="PlaylistItem_DragLeave"/><EventSetter Event="Drop" Handler="PlaylistItem_Drop"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBorder" CornerRadius="8" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#1D222C"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#302B57"/></Trigger><Trigger Property="Tag" Value="DragOver"><Setter TargetName="ItemBorder" Property="Background" Value="#403878"/><Setter TargetName="ItemBorder" Property="BorderBrush" Value="#8B7CFF"/><Setter TargetName="ItemBorder" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate DataType="{x:Type models:Playlist}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}"/><TextBlock Grid.Column="1" Text="{Binding TrackIds.Count}" Foreground="#737A89" FontSize="10"/></Grid></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <Button Grid.Row="4" Content="＋  New playlist" Click="NewPlaylist_Click" Style="{StaticResource PrimaryButtonStyle}" Background="#272243" Foreground="#CBC5FF"/>
                <StackPanel Grid.Row="5" Margin="0,16,0,0">
                    <Button x:Name="IpodHeaderButton" Content="IPOD" Click="ShowIpodSource_Click" Style="{StaticResource SectionHeaderButtonStyle}"
                            AllowDrop="True" DragOver="IpodNav_DragOver" DragLeave="IpodNav_DragLeave" Drop="IpodNav_Drop"/>
                    <StackPanel x:Name="IpodNav" Visibility="Collapsed">
                        <Button x:Name="IpodArtistsButton" Content="●    Artists" Tag="Artists" Click="IpodCategory_Click" Style="{StaticResource NavButtonStyle}"/>
                        <Button x:Name="IpodAlbumsButton" Content="▣    Albums" Tag="Albums" Click="IpodCategory_Click" Style="{StaticResource NavButtonStyle}"/>
                        <Button x:Name="IpodGenresButton" Content="◇    Genres" Tag="Genres" Click="IpodCategory_Click" Style="{StaticResource NavButtonStyle}"/>
                        <Button x:Name="IpodSongsButton" Content="♫    Songs" Tag="Songs" Click="IpodCategory_Click" Style="{StaticResource NavButtonStyle}"/>
                        <TextBlock x:Name="IpodNavHint" Text="Drag music onto IPOD to sync" Foreground="#6E7584" FontSize="10" Margin="12,7,0,2"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="38,32,38,30">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid>
                <StackPanel>
                    <Button x:Name="BackButton" Content="← Back" Visibility="Collapsed" Click="BackButton_Click" HorizontalAlignment="Left" Foreground="#9D91FF" Background="Transparent" BorderThickness="0" Padding="0,0,0,8"/>
                    <TextBlock Text="MUSIC COLLECTION" Style="{StaticResource EyebrowStyle}"/>
                    <TextBlock x:Name="ViewTitle" Text="Albums" FontSize="34" FontWeight="SemiBold" Margin="0,4,0,2"/>
                    <TextBlock x:Name="ViewSubtitle" Foreground="#7D8493" FontSize="12"/>
                    <TextBlock x:Name="PlaybackStatus" Foreground="#A79DFF" FontSize="11" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"><Button Content="⊙  Duplicates" Click="Duplicates_Click" Margin="0,0,9,0" Padding="13,8" Background="#161A22" Foreground="#BCC2CD" BorderBrush="#303744"/><Border Width="260" Height="39" Background="#12151C" BorderBrush="#262C38" BorderThickness="1" CornerRadius="10" Padding="12,7"><DockPanel><TextBlock Text="⌕" Foreground="#747B8B" Margin="0,0,8,0"/><TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" Background="Transparent" BorderThickness="0" Foreground="#F4F6FA" CaretBrush="#F4F6FA"/></DockPanel></Border></StackPanel>
            </Grid>
            <ScrollViewer x:Name="GroupsScroller" Grid.Row="1" Margin="0,28,0,0" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="GroupsView"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding Name}" Click="GroupCard_Click" MouseDoubleClick="GroupCard_MouseDoubleClick" ContextMenuOpening="GroupCard_ContextMenuOpening" PreviewMouseLeftButtonDown="GroupCard_PreviewMouseLeftButtonDown" PreviewMouseMove="GroupCard_PreviewMouseMove" Width="184" Margin="0,0,18,18" Padding="0" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"><Button.ContextMenu><ContextMenu/></Button.ContextMenu>
                        <StackPanel><Border Height="145" CornerRadius="12" Background="{Binding Color}" BorderBrush="#303744" BorderThickness="1"><Grid><Ellipse Width="92" Height="92" Stroke="#FFFFFF" StrokeThickness="1" Opacity="0.13"/><Ellipse Width="30" Height="30" Fill="#0B0D12" Opacity="0.35"/><TextBlock Text="{Binding Initial}" FontSize="36" Foreground="#DAD7FF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border><TextBlock Text="{Binding Name}" Foreground="#F4F6FA" FontWeight="SemiBold" Margin="3,10,3,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Foreground="#7D8493" FontSize="11" Margin="3,3,3,0"/></StackPanel>
                    </Button></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Border x:Name="TracksBorder" Grid.Row="1" Margin="0,28,0,0" BorderBrush="#262C38" BorderThickness="1" CornerRadius="12" Background="#12151C" Visibility="Collapsed">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border x:Name="SelectionBar" Visibility="Collapsed" Background="Transparent" BorderBrush="#262C38" BorderThickness="0,0,0,1" Padding="15,9"><DockPanel><Button Content="Clear" DockPanel.Dock="Right" Click="ClearSelection_Click" Background="Transparent" Foreground="#9D91FF" BorderThickness="0"/><TextBlock x:Name="SelectionText" Foreground="#7D8493" FontSize="11" VerticalAlignment="Center"/></DockPanel></Border>
                <DataGrid x:Name="TracksGrid" Grid.Row="1" AutoGenerateColumns="False" HeadersVisibility="Column" GridLinesVisibility="None" Background="Transparent" BorderThickness="0" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="TracksGrid_SelectionChanged" MouseDoubleClick="TracksGrid_MouseDoubleClick" PreviewMouseLeftButtonDown="TracksGrid_PreviewMouseLeftButtonDown" PreviewMouseMove="TracksGrid_PreviewMouseMove" ContextMenuOpening="TracksGrid_ContextMenuOpening">
                    <DataGrid.ContextMenu><ContextMenu/></DataGrid.ContextMenu>
                    <DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding TrackNumber}" Width="48"/><DataGridTextColumn Header="TITLE" Binding="{Binding Title}" Width="2*"/><DataGridTextColumn Header="ARTIST" Binding="{Binding Artist}" Width="*"/><DataGridTextColumn Header="ALBUM" Binding="{Binding Album}" Width="*"/><DataGridTextColumn Header="GENRE" Binding="{Binding Genre}" Width="110"/><DataGridTextColumn Header="TIME" Binding="{Binding DurationText}" Width="70"/></DataGrid.Columns>
                </DataGrid>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="1" Grid.Column="1" Background="#161A22" BorderBrush="#2A303C" BorderThickness="0,1,0,0" Padding="24,10">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="220"/><ColumnDefinition Width="1.4*" MinWidth="380"/><ColumnDefinition Width="*" MinWidth="140"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="50" Height="50" CornerRadius="8" Background="#3F3A75"><TextBlock x:Name="PlayerArtInitial" Text="♫" FontSize="20" Foreground="#DED9FF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel Margin="12,6,0,0"><TextBlock x:Name="PlayerTitle" Text="Choose something to play" FontWeight="SemiBold" FontSize="13"/><TextBlock x:Name="PlayerArtist" Text="Your library is ready" Foreground="#7F8696" FontSize="11" Margin="0,4,0,0"/></StackPanel>
                </StackPanel>
                <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="◀│" Click="Previous_Click" Background="Transparent" Foreground="#B8BEC9" BorderThickness="0" Width="45"/>
                        <Button x:Name="PlayPauseButton" Content="▶" Click="PlayPause_Click" Background="#F4F6FA" Foreground="#11141A" BorderThickness="0" Width="34" Height="34" FontSize="12"/>
                        <Button Content="│▶" Click="Next_Click" Background="Transparent" Foreground="#B8BEC9" BorderThickness="0" Width="45"/>
                    </StackPanel>
                    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="ElapsedText" Text="0:00" Foreground="#777E8D" FontSize="10" VerticalAlignment="Center"/>
                        <Slider x:Name="ProgressSlider" Grid.Column="1" Minimum="0" Maximum="1" ValueChanged="ProgressSlider_ValueChanged" VerticalAlignment="Center" Foreground="#8B7CFF"/>
                        <TextBlock x:Name="RemainingText" Grid.Column="2" Text="-0:00" Foreground="#777E8D" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>
                </Grid>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="VOL" Foreground="#6E7584" FontSize="9" VerticalAlignment="Center" Margin="0,0,8,0"/><Slider x:Name="VolumeSlider" Width="95" Minimum="0" Maximum="1" Value="0.7" ValueChanged="VolumeSlider_ValueChanged"/></StackPanel>
            </Grid>
        </Border>
        <Canvas Grid.Row="0" Grid.Column="1" Panel.ZIndex="12" IsHitTestVisible="True" ClipToBounds="True">
            <Button x:Name="IpodButton" Style="{StaticResource IpodButtonStyle}" Width="300" Height="300" Canvas.Right="-150" Canvas.Bottom="-150" Click="IpodButton_Click" AllowDrop="True" DragOver="IpodButton_DragOver" DragLeave="IpodButton_DragLeave" Drop="IpodButton_Drop" ToolTip="No iPod connected · Click to simulate connection">
                <Button.ContextMenu>
                    <ContextMenu x:Name="IpodMenu" Background="#1D222C" Foreground="#F4F6FA" BorderBrush="#363D4B" Opened="IpodMenu_Opened">
                        <MenuItem x:Name="IpodMenuHeader" Header="No iPod connected" IsEnabled="False" FontWeight="SemiBold"/>
                        <Separator/>
                        <MenuItem x:Name="IpodRescanItem" Header="Rescan for iPod" Click="RescanIpod_Click"/>
                        <Separator/>
                        <MenuItem Header="Sync all" Click="SyncIpod_Click"/>
                        <MenuItem Header="Sync music" Click="SyncIpod_Click"/>
                        <MenuItem Header="Sync changes" Click="SyncIpod_Click"/>
                        <MenuItem Header="Sync podcasts" Click="SyncIpod_Click"/>
                        <Separator/>
                        <MenuItem Header="Eject" Click="EjectIpod_Click"/>
                    </ContextMenu>
                </Button.ContextMenu>
                <Grid>
                    <Grid x:Name="RecordSpinGroup" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><RotateTransform x:Name="RecordRotation"/></Grid.RenderTransform>
                        <Ellipse x:Name="RecordDisc" Fill="#0B0B0E" Stroke="#000000" StrokeThickness="1"/>
                        <Ellipse Margin="14" Stroke="#171719" StrokeThickness="1"/>
                        <Ellipse Margin="22" Stroke="#202024" StrokeThickness="1"/>
                        <Ellipse Margin="32" Stroke="#171719" StrokeThickness="1"/>
                        <Ellipse Margin="44" Stroke="#202024" StrokeThickness="1"/>
                        <Ellipse Margin="58" Stroke="#171719" StrokeThickness="1"/>
                        <Ellipse Margin="74" Stroke="#202024" StrokeThickness="1"/>
                        <Ellipse Margin="92" Stroke="#171719" StrokeThickness="1"/>
                        <Ellipse>
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#22FFFFFF" Offset="0"/>
                                    <GradientStop Color="#00FFFFFF" Offset="0.42"/>
                                    <GradientStop Color="#00FFFFFF" Offset="0.58"/>
                                    <GradientStop Color="#18FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse x:Name="RecordLabel" Width="108" Height="108" Fill="#3A404B"/>
                        <Ellipse Width="34" Height="34" Fill="#0B0B0E"/>
                        <Ellipse Width="8" Height="8" Fill="#000000"/>
                    </Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.RenderTransform><TranslateTransform X="-74" Y="-74"/></StackPanel.RenderTransform>
                        <Border Width="34" Height="50" CornerRadius="5" Background="#D5DAE2" BorderBrush="#FFFFFF" BorderThickness="2" Padding="4">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="16"/><RowDefinition/></Grid.RowDefinitions><Border Background="#8EA6B2"><TextBlock Text="SINK" Foreground="#354252" FontSize="6" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Grid Grid.Row="1"><Ellipse Width="18" Height="18" Fill="#F7F8FA" Stroke="#A0A8B2"/><TextBlock Text="●" Foreground="#7C8490" FontSize="5" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Grid>
                        </Border>
                        <TextBlock x:Name="IpodStateText" Text="OFFLINE" FontSize="9" FontWeight="Bold" Foreground="#9AA1AF" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Button>
        </Canvas>
        <Border x:Name="ImportOverlay" Grid.RowSpan="2" Grid.ColumnSpan="2" Panel.ZIndex="50" Visibility="Collapsed" Margin="14" BorderBrush="#8B7CFF" BorderThickness="2" CornerRadius="18" Background="#EE11141B" IsHitTestVisible="False">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Border Width="66" Height="66" CornerRadius="33" Background="#6559CE"><TextBlock Text="↓" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Drop music to import" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0"/><TextBlock Text="Audio files and nested folders are welcome" Foreground="#8C93A2" FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel>
        </Border>
    </Grid>
</Window>
