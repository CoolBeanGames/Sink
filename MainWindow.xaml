<Window x:Class="Sink.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Sink.Models"
        xmlns:dl="clr-namespace:Sink.Services.Download"
        xmlns:ctrl="clr-namespace:Sink.Controls"
        Title="Sink" Icon="Assets/sink.ico" Width="1260" Height="800" MinWidth="940" MinHeight="620" WindowStartupLocation="CenterScreen" Background="#0B0D12" AllowDrop="True" DragEnter="Window_DragEnter" DragOver="Window_DragOver" DragLeave="Window_DragLeave" Drop="Window_Drop">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <Style x:Key="EpisodeIconButton" TargetType="Button">
            <Setter Property="Background" Value="#242A34"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="C" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="C" Property="Background" Value="#2E3543"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="C" Property="Background" Value="#1C212B"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EyebrowStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="#7D8493"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#12151C"/><Setter Property="Foreground" Value="#747B8A"/><Setter Property="BorderBrush" Value="#262C38"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="Padding" Value="12,10"/><Setter Property="FontSize" Value="10"/></Style>
        <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,9"/><Setter Property="Foreground" Value="#BFC4CE"/><Setter Property="Background" Value="Transparent"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
        <Style TargetType="DataGridRow"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="#20252F"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="MinHeight" Value="48"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1B1F28"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#2B2850"/><Setter Property="Foreground" Value="#F4F6FA"/></Trigger></Style.Triggers></Style>
    </Window.Resources>
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="94"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.RowSpan="2" Background="#12151C" BorderBrush="#262C38" BorderThickness="0,0,1,0" Padding="16,24">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Margin="8,0,0,28">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="Assets/sink.ico" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Sink" FontSize="20" FontWeight="Bold" Foreground="#F4F6FA" Margin="11,3,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="NotificationBell" Click="NotificationBell_Click" ToolTip="Notifications"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Padding="7"
                            Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <Path Width="14" Height="14" Stretch="Uniform" StrokeLineJoin="Round" Stroke="#BCC2CD" StrokeThickness="1.3"
                              Data="M7,1 C4.5,1 3.3,3 3.3,5.7 L3.3,7.5 C3.3,9 2.5,10.3 1.3,11 L12.7,11 C11.5,10.3 10.7,9 10.7,7.5 L10.7,5.7 C10.7,3 9.5,1 7,1 Z M5.3,12.5 C5.3,13.3 6,14 7,14 C8,14 8.7,13.3 8.7,12.5"/>
                    </Button>
                    <Ellipse x:Name="NotificationDot" Width="8" Height="8" Fill="#8B7CFF" Stroke="#12151C" StrokeThickness="1.5"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0" Visibility="Collapsed" IsHitTestVisible="False"/>
                    <Popup x:Name="NotificationPopup" PlacementTarget="{Binding ElementName=NotificationBell}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Width="320" MaxHeight="420" Background="#1A1E27" BorderBrush="#2E3542" BorderThickness="1" CornerRadius="10" Margin="0,6,0,0">
                            <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.4" Color="Black"/></Border.Effect>
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="14,12,10,10">
                                    <TextBlock Text="NOTIFICATIONS" Style="{StaticResource EyebrowStyle}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="NotificationEmptyHint" Text="Nothing yet" Foreground="#6E7584" FontSize="11" HorizontalAlignment="Right" Visibility="Collapsed"/>
                                </Grid>
                                <Button DockPanel.Dock="Bottom" x:Name="ClearAllNotificationsButton" Content="Clear all" Click="ClearAllNotifications_Click"
                                        Margin="10,4,10,10" Padding="0,8" Background="#242A34" Foreground="#BCC2CD" BorderThickness="0" Cursor="Hand"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300">
                                    <ItemsControl x:Name="NotificationList" Margin="6,0,6,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:AppNotification}">
                                                <Border Background="#20242F" CornerRadius="8" Margin="4,3" Padding="10,8">
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Content="✕" Click="ClearNotification_Click" Tag="{Binding}"
                                                                Background="Transparent" BorderThickness="0" Foreground="#8A93A3" Padding="6,0" Cursor="Hand" VerticalAlignment="Top"/>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="#E7E9EE" FontSize="12"/>
                                                            <TextBlock Text="{Binding Occurred, StringFormat='{}{0:t}'}" Foreground="#6E7584" FontSize="10" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Popup>
                </Grid>
                <StackPanel Grid.Row="1">
                    <Button x:Name="MusicHeaderButton" Content="LIBRARY" Tag="Active" Click="ShowMusicSource_Click" Style="{StaticResource SectionHeaderButtonStyle}"/>
                    <StackPanel x:Name="MusicNav">
                        <Button x:Name="ArtistsButton" Content="●    Artists" Tag="Artists" Click="Category_Click" Style="{StaticResource NavButtonStyle}"/>
                        <Button x:Name="AlbumsButton" Content="▣    Albums" Tag="Active" Click="Category_Click" Style="{StaticResource NavButtonStyle}"/>
                        <Button x:Name="GenresButton" Content="◇    Genres" Tag="Genres" Click="Category_Click" Style="{StaticResource NavButtonStyle}"/>
                        <Button x:Name="SongsButton" Content="♫    Songs" Tag="Songs" Click="Category_Click" Style="{StaticResource NavButtonStyle}"/>
                    </StackPanel>
                    <Button x:Name="PodcastsHeaderButton" Click="ShowPodcasts_Click" Style="{StaticResource SectionHeaderButtonStyle}" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="PODCASTS" VerticalAlignment="Center"/>
                            <Ellipse x:Name="PodcastsNewDot" Width="6" Height="6" Fill="#8B7CFF" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                            <Grid x:Name="PodcastSpinner" Width="12" Height="12" Margin="7,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform><RotateTransform/></Grid.RenderTransform>
                                <Ellipse Stroke="#8B7CFF" StrokeThickness="1.7" StrokeDashArray="3.1 1.5" StrokeDashCap="Round"/>
                            </Grid>
                        </StackPanel>
                    </Button>
                    <StackPanel x:Name="PodcastNav" Visibility="Collapsed">
                        <Button x:Name="PodcastLibraryButton" Content="▤    Library" Tag="Active" Click="PodcastMode_Click" Style="{StaticResource NavButtonStyle}"/>
                        <Button x:Name="PodcastSearchButton" Content="⌕    Search" Tag="Search" Click="PodcastMode_Click" Style="{StaticResource NavButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
                <Grid Grid.Row="2" Margin="10,24,4,8"><TextBlock Text="PLAYLISTS" Style="{StaticResource EyebrowStyle}"/><Button Content="＋" HorizontalAlignment="Right" Margin="0,-8,0,0" Foreground="#8B7CFF" Background="Transparent" BorderThickness="0" FontSize="20" Click="NewPlaylist_Click"/></Grid>
                <ListBox x:Name="PlaylistList" Grid.Row="3" Background="Transparent" BorderThickness="0" SelectionChanged="PlaylistList_SelectionChanged" ContextMenuOpening="PlaylistList_ContextMenuOpening">
                    <ListBox.ContextMenu><ContextMenu/></ListBox.ContextMenu>
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,2"/><Setter Property="Foreground" Value="#B6BCC8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="AllowDrop" Value="True"/><EventSetter Event="DragOver" Handler="PlaylistItem_DragOver"/><EventSetter Event="DragLeave" Handler="PlaylistItem_DragLeave"/><EventSetter Event="Drop" Handler="PlaylistItem_Drop"/><EventSetter Event="PreviewMouseLeftButtonDown" Handler="PlaylistItem_PreviewMouseLeftButtonDown"/><EventSetter Event="PreviewMouseMove" Handler="PlaylistItem_PreviewMouseMove"/><EventSetter Event="PreviewMouseRightButtonDown" Handler="PlaylistItem_PreviewMouseRightButtonDown"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBorder" CornerRadius="8" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#1D222C"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#302B57"/></Trigger><Trigger Property="Tag" Value="DragOver"><Setter TargetName="ItemBorder" Property="Background" Value="#403878"/><Setter TargetName="ItemBorder" Property="BorderBrush" Value="#8B7CFF"/><Setter TargetName="ItemBorder" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate DataType="{x:Type models:Playlist}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}"/><TextBlock Grid.Column="1" Text="{Binding TrackIds.Count}" Foreground="#737A89" FontSize="10"/></Grid></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <Button Grid.Row="4" Content="＋  New playlist" Click="NewPlaylist_Click" Style="{StaticResource PrimaryButtonStyle}" Background="#272243" Foreground="#CBC5FF"/>
                <StackPanel Grid.Row="5" Margin="0,16,0,0">
                    <Button x:Name="IpodHeaderButton" Click="ShowIpodSource_Click" Style="{StaticResource SectionHeaderButtonStyle}"
                            AllowDrop="True" DragOver="IpodNav_DragOver" DragLeave="IpodNav_DragLeave" Drop="IpodNav_Drop">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="11" Height="17" CornerRadius="2.5" Background="#8B7CFF" Margin="0,0,7,0">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="7"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <Border Background="#1B1E27" Margin="1.5,1.5,1.5,0" CornerRadius="1"/>
                                    <Ellipse Grid.Row="1" Width="6" Height="6" Fill="#1B1E27" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="IPOD" VerticalAlignment="Center"/>
                            <Grid x:Name="IpodSpinner" Width="12" Height="12" Margin="7,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform><RotateTransform/></Grid.RenderTransform>
                                <Ellipse Stroke="#8B7CFF" StrokeThickness="1.7" StrokeDashArray="3.1 1.5" StrokeDashCap="Round"/>
                            </Grid>
                        </StackPanel>
                    </Button>
                    <StackPanel x:Name="IpodNav" Visibility="Collapsed">
                        <Button x:Name="IpodArtistsButton" Content="●    Artists" Tag="Artists" Click="IpodCategory_Click" Style="{StaticResource NavButtonStyle}"/>
                        <Button x:Name="IpodAlbumsButton" Content="▣    Albums" Tag="Albums" Click="IpodCategory_Click" Style="{StaticResource NavButtonStyle}"/>
                        <Button x:Name="IpodGenresButton" Content="◇    Genres" Tag="Genres" Click="IpodCategory_Click" Style="{StaticResource NavButtonStyle}"/>
                        <Button x:Name="IpodSongsButton" Content="♫    Songs" Tag="Songs" Click="IpodCategory_Click" Style="{StaticResource NavButtonStyle}"/>
                        <TextBlock x:Name="IpodNavHint" Text="Drag music onto IPOD to sync" Foreground="#6E7584" FontSize="10" Margin="12,7,0,2"/>
                    </StackPanel>
                    <Button x:Name="DownloadHeaderButton" Click="ShowDownloadSource_Click" Style="{StaticResource SectionHeaderButtonStyle}" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="15" Height="17" Margin="0,0,7,0">
                                <Path Data="M7,0 L7,9 M3,6 L7,10 L11,6 M1,14 L13,14" Stroke="#8B7CFF" StrokeThickness="1.6" StrokeEndLineCap="Round" StrokeStartLineCap="Round"/>
                            </Border>
                            <TextBlock Text="DOWNLOAD" VerticalAlignment="Center"/>
                            <Grid x:Name="DownloadSpinner" Width="12" Height="12" Margin="7,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform><RotateTransform/></Grid.RenderTransform>
                                <Ellipse Stroke="#8B7CFF" StrokeThickness="1.7" StrokeDashArray="3.1 1.5" StrokeDashCap="Round"/>
                            </Grid>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock x:Name="VersionText" Grid.Row="6" Margin="10,14,0,0" Foreground="#5A616E" FontSize="10" Text="v0.13.0"/>
            </Grid>
        </Border>
        <Grid x:Name="MusicPage" Grid.Column="1" Margin="38,32,38,30">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid>
                <StackPanel>
                    <Button x:Name="BackButton" Content="← Back" Visibility="Collapsed" Click="BackButton_Click" HorizontalAlignment="Left" Foreground="#9D91FF" Background="Transparent" BorderThickness="0" Padding="0,0,0,8"/>
                    <TextBlock Text="MUSIC COLLECTION" Style="{StaticResource EyebrowStyle}"/>
                    <TextBlock x:Name="ViewTitle" Text="Albums" FontSize="34" FontWeight="SemiBold" Margin="0,4,0,2"/>
                    <TextBlock x:Name="ViewSubtitle" Foreground="#7D8493" FontSize="12"/>
                    <TextBlock x:Name="PlaybackStatus" Foreground="#A79DFF" FontSize="11" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"><Button Content="⚙" Click="Settings_Click" ToolTip="Settings" Margin="0,0,9,0" Padding="11,8" FontSize="14" Background="#161A22" Foreground="#BCC2CD" BorderBrush="#303744"/><Button Content="⊙  Duplicates" Click="Duplicates_Click" Margin="0,0,9,0" Padding="13,8" Background="#161A22" Foreground="#BCC2CD" BorderBrush="#303744"/><Border Width="260" Height="39" Background="#12151C" BorderBrush="#262C38" BorderThickness="1" CornerRadius="10" Padding="12,7"><DockPanel><TextBlock Text="⌕" Foreground="#747B8B" Margin="0,0,8,0"/><TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" Background="Transparent" BorderThickness="0" Foreground="#F4F6FA" CaretBrush="#F4F6FA"/></DockPanel></Border></StackPanel>
            </Grid>
            <ScrollViewer x:Name="GroupsScroller" Grid.Row="1" Margin="0,28,0,0" VerticalScrollBarVisibility="Auto">
                <ListBox x:Name="GroupsView" Background="Transparent" BorderThickness="0" SelectionMode="Extended"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False"
                         MouseDoubleClick="GroupCard_MouseDoubleClick" ContextMenuOpening="GroupsView_ContextMenuOpening"
                         PreviewMouseLeftButtonDown="GroupCard_PreviewMouseLeftButtonDown" PreviewMouseMove="GroupCard_PreviewMouseMove">
                    <ListBox.ContextMenu><ContextMenu/></ListBox.ContextMenu>
                    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,12,12"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Sel" CornerRadius="14" Padding="4" BorderThickness="2" BorderBrush="Transparent" Background="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Sel" Property="Background" Value="#161A22"/></Trigger>
                                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Sel" Property="BorderBrush" Value="#8B7CFF"/><Setter TargetName="Sel" Property="Background" Value="#221F3D"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate>
                        <StackPanel Width="184"><Border Height="145" CornerRadius="12" Background="{Binding Color}" BorderBrush="#303744" BorderThickness="1" ClipToBounds="True"><Grid><Ellipse Width="92" Height="92" Stroke="#FFFFFF" StrokeThickness="1" Opacity="0.13"/><Ellipse Width="30" Height="30" Fill="#0B0D12" Opacity="0.35"/><TextBlock Text="{Binding Initial}" FontSize="36" Foreground="#DAD7FF" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Art}" Stretch="UniformToFill"/></Grid></Border><TextBlock Text="{Binding Name}" Foreground="#F4F6FA" FontWeight="SemiBold" Margin="3,10,3,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Foreground="#7D8493" FontSize="11" Margin="3,3,3,0"/></StackPanel>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
            <Border x:Name="TracksBorder" Grid.Row="1" Margin="0,28,0,0" BorderBrush="#262C38" BorderThickness="1" CornerRadius="12" Background="#12151C" Visibility="Collapsed">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border x:Name="SelectionBar" Visibility="Collapsed" Background="Transparent" BorderBrush="#262C38" BorderThickness="0,0,0,1" Padding="15,9"><DockPanel><Button Content="Clear" DockPanel.Dock="Right" Click="ClearSelection_Click" Background="Transparent" Foreground="#9D91FF" BorderThickness="0"/><TextBlock x:Name="SelectionText" Foreground="#7D8493" FontSize="11" VerticalAlignment="Center"/></DockPanel></Border>
                <DataGrid x:Name="TracksGrid" Grid.Row="1" AutoGenerateColumns="False" HeadersVisibility="Column" GridLinesVisibility="None" Background="Transparent" BorderThickness="0" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="TracksGrid_SelectionChanged" MouseDoubleClick="TracksGrid_MouseDoubleClick" PreviewMouseLeftButtonDown="TracksGrid_PreviewMouseLeftButtonDown" PreviewMouseMove="TracksGrid_PreviewMouseMove" ContextMenuOpening="TracksGrid_ContextMenuOpening">
                    <DataGrid.ContextMenu><ContextMenu/></DataGrid.ContextMenu>
                    <DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding TrackNumber}" Width="48"/><DataGridTextColumn Header="TITLE" Binding="{Binding Title}" Width="2*"/><DataGridTextColumn Header="ARTIST" Binding="{Binding Artist}" Width="*"/><DataGridTextColumn Header="ALBUM" Binding="{Binding Album}" Width="*"/><DataGridTextColumn Header="GENRE" Binding="{Binding Genre}" Width="110"/><DataGridTextColumn Header="TIME" Binding="{Binding DurationText}" Width="70"/></DataGrid.Columns>
                </DataGrid>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="DownloadPage" Grid.Column="1" Margin="38,32,38,24" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="GET MUSIC" Style="{StaticResource EyebrowStyle}"/>
                <TextBlock Text="Download" FontSize="34" FontWeight="SemiBold" Margin="0,4,0,2"/>
                <TextBlock x:Name="DownloadSubtitle" Foreground="#7D8493" FontSize="12" Text="Paste YouTube links, tidy the details, then download."/>
            </StackPanel>

            <Border Grid.Row="1" Margin="0,22,0,0" BorderBrush="#262C38" BorderThickness="1" CornerRadius="12" Background="#12151C">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel Margin="15,11,12,11">
                        <Button DockPanel.Dock="Right" Content="＋  Add link" Click="AddLink_Click" Style="{StaticResource PrimaryButtonStyle}" Background="#272243" Foreground="#CBC5FF" Padding="12,7"/>
                        <TextBlock Text="LINKS" Style="{StaticResource EyebrowStyle}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Border Grid.Row="1" BorderBrush="#20252F" BorderThickness="0,1,0,0">
                        <Grid>
                            <TextBlock x:Name="DownloadEmptyHint" Text="No links yet — click Add link to paste one." Foreground="#6E7584" FontSize="12" Margin="16,18" HorizontalAlignment="Center"/>
                            <TreeView x:Name="LinksTree" Background="Transparent" BorderThickness="0" MaxHeight="430" Padding="8,8,8,10"
                                      VirtualizingStackPanel.IsVirtualizing="False"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      TreeViewItem.Expanded="LinksTree_ItemExpanded"
                                      SelectedItemChanged="LinksTree_SelectedItemChanged"
                                      PreviewMouseRightButtonDown="LinksTree_PreviewRightButtonDown"
                                      ContextMenuOpening="LinksTree_ContextMenuOpening">
                                <TreeView.ContextMenu><ContextMenu/></TreeView.ContextMenu>
                                <TreeView.Resources>
                                    <Style x:Key="NodeField" TargetType="TextBox">
                                        <Setter Property="Background" Value="#12151C"/>
                                        <Setter Property="Foreground" Value="#D8DCE4"/>
                                        <Setter Property="CaretBrush" Value="#F4F6FA"/>
                                        <Setter Property="BorderBrush" Value="#2A303C"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Padding" Value="6,4"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="0,0,8,0"/>
                                        <EventSetter Event="PreviewKeyDown" Handler="NodeField_PreviewKeyDown"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#8B7CFF"/></Trigger>
                                        </Style.Triggers>
                                    </Style>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TreeViewItem">
                                                    <StackPanel>
                                                        <Grid x:Name="Row" Background="Transparent">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <ToggleButton x:Name="Expander" Grid.Column="0" Focusable="False" Width="18" Height="18" VerticalAlignment="Center"
                                                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                                          Foreground="#8A93A3" Cursor="Hand" Content="▸">
                                                                <ToggleButton.Template>
                                                                    <ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate>
                                                                </ToggleButton.Template>
                                                                <ToggleButton.Style>
                                                                    <Style TargetType="ToggleButton"><Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Content" Value="▾"/></Trigger></Style.Triggers></Style>
                                                                </ToggleButton.Style>
                                                            </ToggleButton>
                                                            <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"/>
                                                        </Grid>
                                                        <ItemsPresenter x:Name="Items" Margin="18,0,0,0"/>
                                                    </StackPanel>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsExpanded" Value="False"><Setter TargetName="Items" Property="Visibility" Value="Collapsed"/></Trigger>
                                                        <Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden"/></Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True" SourceName="Row"><Setter TargetName="Row" Property="Background" Value="#181C24"/></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                    <HierarchicalDataTemplate DataType="{x:Type dl:DownloadNode}" ItemsSource="{Binding Children}">
                                        <Border Background="Transparent" Padding="0,5" MinHeight="30" BorderBrush="#191D25" BorderThickness="0,0,0,1">
                                            <DockPanel LastChildFill="False">
                                                <Border DockPanel.Dock="Left" Background="Transparent" Cursor="Hand" Padding="4" Margin="0,0,5,0"
                                                        VerticalAlignment="Center" ToolTip="{Binding StatusGlyphTooltip}"
                                                        PreviewMouseLeftButtonDown="StatusGlyph_Click">
                                                    <Ellipse Width="12" Height="12" Fill="{Binding StatusBrush}" Stroke="#3A4250" StrokeThickness="1">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect ShadowDepth="0" BlurRadius="{Binding StatusGlowRadius}"
                                                                              Color="{Binding StatusGlowColor}" Opacity="{Binding StatusGlowOpacity}"/>
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                </Border>
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Index}" Width="26" VerticalAlignment="Center" Foreground="#6E7584" FontSize="11"
                                                           Visibility="{Binding IsTrack, Converter={StaticResource B2V}}"/>
                                                <Button DockPanel.Dock="Right" Content="✕" Click="RemoveNode_Click" Background="Transparent" Foreground="#8A93A3" BorderThickness="0" Padding="6,0" FontSize="11" Cursor="Hand" ToolTip="Remove" VerticalAlignment="Center"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" ToolTip="{Binding StatusText}" VerticalAlignment="Center" Foreground="#8A93A3" FontSize="11" Margin="14,0,6,0" MaxWidth="260" TextTrimming="CharacterEllipsis"/>
                                                <Grid DockPanel.Dock="Right" Width="13" Height="13" Margin="6,0,2,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                                                      ToolTip="Working…" Visibility="Collapsed"
                                                      Loaded="TrackSpinner_Loaded" Unloaded="TrackSpinner_Unloaded">
                                                    <Grid.RenderTransform><RotateTransform/></Grid.RenderTransform>
                                                    <Ellipse Stroke="#8B7CFF" StrokeThickness="1.8" StrokeDashArray="3.1 1.5" StrokeDashCap="Round"/>
                                                </Grid>
                                                <TextBox DockPanel.Dock="Left" Width="300" Tag="Name" Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource NodeField}" PreviewMouseLeftButtonDown="NodeName_PreviewMouseDown"
                                                         ToolTip="Double-click a track or single to preview it · arrow keys move between fields"/>
                                                <TextBox DockPanel.Dock="Left" Width="44" Tag="Track" Text="{Binding TrackNumberText, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource NodeField}" Visibility="{Binding ShowTrackNumber, Converter={StaticResource B2V}}"
                                                         ToolTip="Track number"/>
                                                <ctrl:AutoCompleteTextBox DockPanel.Dock="Left" Width="150" Tag="Artist" SuggestionField="Artist" Text="{Binding Artist, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource NodeField}" Visibility="{Binding ShowArtist, Converter={StaticResource B2V}}"/>
                                                <ctrl:AutoCompleteTextBox DockPanel.Dock="Left" Width="150" Tag="Album" SuggestionField="Album" Text="{Binding Album, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource NodeField}" Visibility="{Binding ShowAlbum, Converter={StaticResource B2V}}"/>
                                                <ctrl:AutoCompleteTextBox DockPanel.Dock="Left" Width="120" Tag="Genre" SuggestionField="Genre" Text="{Binding Genre, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource NodeField}" Visibility="{Binding ShowGenre, Converter={StaticResource B2V}}"/>
                                            </DockPanel>
                                        </Border>
                                    </HierarchicalDataTemplate>
                                </TreeView.Resources>
                            </TreeView>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="DownloadOptionsPanel" Grid.Row="2" VerticalAlignment="Top" Margin="0,16,0,0" BorderBrush="#262C38" BorderThickness="1" CornerRadius="12" Background="#12151C" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="DOWNLOAD OPTIONS" Style="{StaticResource EyebrowStyle}" Margin="0,0,0,12"/>
                    <WrapPanel>
                        <CheckBox x:Name="OptMetadata" Content="Write metadata tags" IsChecked="True" Foreground="#C7CCD6" Margin="0,0,26,10"/>
                        <CheckBox x:Name="OptAlbumArt" Content="Embed album art" IsChecked="True" Foreground="#C7CCD6" Margin="0,0,26,10"/>
                        <CheckBox x:Name="OptMusicMeta" Content="Prefer YouTube Music details" IsChecked="True" Foreground="#C7CCD6" Margin="0,0,26,10"/>
                        <CheckBox x:Name="OptNumberTracks" Content="Number tracks by list order" Foreground="#C7CCD6" Margin="0,0,26,10"
                                  ToolTip="Write each album track's position (1, 2, 3…) as its track number when it doesn't already have one"/>
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <StackPanel Margin="0,0,26,0">
                            <TextBlock Text="FORMAT" Style="{StaticResource EyebrowStyle}" Margin="0,0,0,5"/>
                            <ComboBox x:Name="OptFormat" Width="140" SelectedIndex="0">
                                <ComboBoxItem Content="MP3"/>
                                <ComboBoxItem Content="M4A (AAC)"/>
                                <ComboBoxItem Content="Opus"/>
                                <ComboBoxItem Content="FLAC (lossless)"/>
                                <ComboBoxItem Content="WAV"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="QUALITY" Style="{StaticResource EyebrowStyle}" Margin="0,0,0,5"/>
                            <ComboBox x:Name="OptQuality" Width="160" SelectedIndex="0">
                                <ComboBoxItem Content="Best available" Tag="0"/>
                                <ComboBoxItem Content="320 kbps" Tag="320"/>
                                <ComboBoxItem Content="256 kbps" Tag="256"/>
                                <ComboBoxItem Content="192 kbps" Tag="192"/>
                                <ComboBoxItem Content="128 kbps" Tag="128"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <Grid>
                        <TextBlock x:Name="DownloadProgressLabel" Text="0 of 0 downloaded" Foreground="#7D8493" FontSize="11"/>
                    </Grid>
                    <ProgressBar x:Name="DownloadProgressBar" Height="8" Minimum="0" Maximum="1" Value="0" Margin="0,6,16,0"
                                 Background="#1B1F28" BorderThickness="0" Foreground="#8B7CFF"/>
                </StackPanel>
                <Button x:Name="DownloadButton" Grid.Column="1" Content="⭳  Download" Click="StartDownloads_Click" Style="{StaticResource PrimaryButtonStyle}" Padding="18,10" VerticalAlignment="Center"/>
            </Grid>

            <Border Grid.Row="5" Margin="0,16,0,0" Background="#161A22" BorderBrush="#2A303C" BorderThickness="1" CornerRadius="9" Padding="13,8">
                <TextBlock x:Name="DownloadStatusBar" Text="Ready" Foreground="#9AA0AE" FontSize="11" TextTrimming="CharacterEllipsis"/>
            </Border>
        </Grid>

        <Grid x:Name="PodcastPage" Grid.Column="1" Margin="38,32,38,24" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid>
                <StackPanel>
                    <Button x:Name="PodcastBackButton" Content="← Shows" Visibility="Collapsed" Click="PodcastBack_Click" HorizontalAlignment="Left" Foreground="#9D91FF" Background="Transparent" BorderThickness="0" Padding="0,0,0,8"/>
                    <TextBlock Text="PODCASTS" Style="{StaticResource EyebrowStyle}"/>
                    <TextBlock x:Name="PodcastTitle" Text="Library" FontSize="34" FontWeight="SemiBold" Margin="0,4,0,2"/>
                    <TextBlock x:Name="PodcastSubtitle" Foreground="#7D8493" FontSize="12"/>
                    <TextBlock x:Name="PodcastStatus" Foreground="#A79DFF" FontSize="11" Margin="0,5,0,0"/>
                </StackPanel>
                <Border Width="290" Height="39" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#12151C" BorderBrush="#262C38" BorderThickness="1" CornerRadius="10" Padding="12,7">
                    <DockPanel>
                        <TextBlock Text="⌕" Foreground="#747B8B" Margin="0,0,8,0"/>
                        <TextBox x:Name="PodcastSearchBox" KeyDown="PodcastSearchBox_KeyDown" Background="Transparent" BorderThickness="0" Foreground="#F4F6FA" CaretBrush="#F4F6FA"/>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Show mode toolbar -->
            <StackPanel x:Name="PodcastShowToolbar" Grid.Row="1" Margin="0,20,0,0" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Auto-download" Foreground="#9AA0AE" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="RuleCountCombo" Width="80" SelectionChanged="RuleChanged" Margin="0,0,8,0">
                        <ComboBoxItem Content="Off" Tag="0"/>
                        <ComboBoxItem Content="1" Tag="1"/>
                        <ComboBoxItem Content="2" Tag="2"/>
                        <ComboBoxItem Content="3" Tag="3"/>
                        <ComboBoxItem Content="5" Tag="5"/>
                        <ComboBoxItem Content="10" Tag="10"/>
                    </ComboBox>
                    <ComboBox x:Name="RuleModeCombo" Width="120" SelectionChanged="RuleChanged" Margin="0,0,8,0">
                        <ComboBoxItem Content="newest"/>
                        <ComboBoxItem Content="oldest"/>
                    </ComboBox>
                    <TextBlock Text="episodes" Foreground="#9AA0AE" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Border Width="220" Height="34" Background="#12151C" BorderBrush="#262C38" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,10,0">
                        <TextBox x:Name="EpisodeFilterBox" TextChanged="EpisodeFilter_Changed" Background="Transparent" BorderThickness="0" Foreground="#F4F6FA" CaretBrush="#F4F6FA" VerticalContentAlignment="Center"/>
                    </Border>
                    <ComboBox x:Name="EpisodeSort" Width="170" SelectionChanged="EpisodeSort_Changed" Margin="0,0,10,0">
                        <ComboBoxItem Content="Newest first"/>
                        <ComboBoxItem Content="Oldest first"/>
                        <ComboBoxItem Content="Title A–Z"/>
                        <ComboBoxItem Content="Episode number"/>
                    </ComboBox>
                    <CheckBox x:Name="EpisodeUnplayedOnly" Content="Unplayed only" Foreground="#C7CCD6" VerticalAlignment="Center" Click="EpisodeFilter_Changed"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Download all" Click="DownloadAllEpisodes_Click" Background="#1E2A20" Foreground="#8FD69A" BorderThickness="0" Padding="12,7" Margin="0,0,8,0" Cursor="Hand"/>
                    <Button Content="Mark all played" Click="MarkAllPlayed_Click" Background="#242A34" Foreground="#CBD0DA" BorderThickness="0" Padding="12,7" Margin="0,0,8,0" Cursor="Hand"/>
                    <Button Content="Delete all downloads" Click="DeleteAllDownloads_Click" Background="#2E2022" Foreground="#E0918C" BorderThickness="0" Padding="12,7" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>

            <ScrollViewer Grid.Row="2" Margin="0,22,0,0" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <!-- LIBRARY MODE -->
                    <ItemsControl x:Name="PodcastLibraryView">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Button Style="{StaticResource CardButtonStyle}" Width="184" Margin="0,0,12,14" MouseDoubleClick="PodcastCard_DoubleClick" Click="PodcastCard_DoubleClick">
                                <StackPanel>
                                    <Grid>
                                        <Border Height="160" CornerRadius="12" Background="#273A78" BorderBrush="#303744" BorderThickness="1" ClipToBounds="True">
                                            <Grid>
                                                <TextBlock Text="🎙" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image Source="{Binding ArtworkUrl}" Stretch="UniformToFill"/>
                                            </Grid>
                                        </Border>
                                        <Border Width="14" Height="14" CornerRadius="7" Background="#8B7CFF" BorderBrush="#0B0D12" BorderThickness="2"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0"
                                                Visibility="{Binding HasNewUnplayed, Converter={StaticResource B2V}}" ToolTip="New episodes"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Title}" Foreground="#F4F6FA" FontWeight="SemiBold" Margin="3,10,3,0" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Author}" Foreground="#7D8493" FontSize="11" Margin="3,3,3,0" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Foreground="#9D91FF" FontSize="10.5" Margin="3,5,3,0">
                                        <Run Text="{Binding UnplayedCount, Mode=OneWay}"/><Run Text=" unplayed · "/><Run Text="{Binding Episodes.Count, Mode=OneWay}"/><Run Text=" episodes"/>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- SEARCH MODE -->
                    <ItemsControl x:Name="PodcastSearchView" Visibility="Collapsed">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border Background="#12151C" BorderBrush="#20252F" BorderThickness="1" CornerRadius="10" Margin="0,0,0,8" Padding="12">
                                <DockPanel>
                                    <Border Width="64" Height="64" CornerRadius="8" ClipToBounds="True" Background="#273A78" DockPanel.Dock="Left" Margin="0,0,12,0">
                                        <Image Source="{Binding ArtworkUrl}" Stretch="UniformToFill"/>
                                    </Border>
                                    <Button Content="Subscribe" DockPanel.Dock="Right" VerticalAlignment="Center" Click="Subscribe_Click" Style="{StaticResource PrimaryButtonStyle}" Background="#272243" Foreground="#CBC5FF" Padding="12,7"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" Foreground="#F4F6FA" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Author}" Foreground="#7D8493" FontSize="11" Margin="0,2,0,0"/>
                                        <TextBlock Foreground="#7D8493" FontSize="10.5" Margin="0,4,0,0">
                                            <Run Text="{Binding EpisodeCount, Mode=OneWay}"/><Run Text=" episodes"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- SHOW MODE -->
                    <ItemsControl x:Name="EpisodeView" Visibility="Collapsed">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border Background="#12151C" BorderBrush="#20252F" BorderThickness="1" CornerRadius="10" Margin="0,0,0,7" Padding="13,10"
                                    MouseMove="Episode_MouseMove" PreviewMouseLeftButtonDown="Episode_MouseDown">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                            <Button Content="▶" Click="EpisodePlay_Click" ToolTip="Play" Style="{StaticResource PlayButtonStyle}" Width="30" Height="30" Margin="4,0"/>
                                            <Button x:Name="DlBtn" Click="EpisodeDownload_Click" ToolTip="Download" Style="{StaticResource EpisodeIconButton}">
                                                <Grid Width="14" Height="14">
                                                    <Path x:Name="DlArrow" Data="M7,1 L7,9 M3.5,6 L7,9.5 L10.5,6 M2,12.5 L12,12.5" Stroke="#5FC46B" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                    <Path x:Name="DlX" Data="M2,2 L12,12 M12,2 L2,12" Stroke="#E56A63" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                                                </Grid>
                                            </Button>
                                            <Button x:Name="EyeBtn" Click="EpisodeMarkPlayed_Click" ToolTip="Mark played / unplayed" Style="{StaticResource EpisodeIconButton}" Padding="7,9">
                                                <Grid Width="18" Height="12">
                                                    <Path x:Name="EyeOpen" Data="M1,6 C4,1 14,1 17,6 C14,11 4,11 1,6 Z" Stroke="#CBD0DA" StrokeThickness="1.2" Fill="Transparent"/>
                                                    <Ellipse x:Name="EyePupil" Width="4.5" Height="4.5" Fill="#CBD0DA"/>
                                                    <Path x:Name="EyeClosed" Data="M1,5 C4,10 14,10 17,5 M3,8 L2.2,9.6 M9,9.6 L9,11.4 M15,8 L15.8,9.6" Stroke="#8B7CFF" StrokeThickness="1.4" StrokeStartLineCap="Round" Visibility="Collapsed"/>
                                                </Grid>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Fill="#8B7CFF" Margin="0,0,7,0" VerticalAlignment="Center"
                                                         Visibility="{Binding IsNew, Converter={StaticResource B2V}}" ToolTip="New"/>
                                                <TextBlock Text="{Binding Title}" Foreground="#F4F6FA" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Foreground="#7D8493" FontSize="10.5" Margin="0,3,0,0">
                                                <Run Text="{Binding Published, StringFormat=d, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding RemainingText, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                    <ProgressBar Grid.Row="1" Height="4" Margin="0,8,0,0" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Background="#1B1F28" BorderThickness="0" Foreground="#8B7CFF"/>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                                    <Setter TargetName="DlArrow" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="DlX" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="DlBtn" Property="ToolTip" Value="Delete download"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPlayed}" Value="True">
                                    <Setter TargetName="EyeOpen" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="EyePupil" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="EyeClosed" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="PodcastEmptyHint" Foreground="#6E7584" FontSize="12" HorizontalAlignment="Center" Margin="0,40,0,0"
                               Text="No podcasts yet — use Search to find a show and Subscribe."/>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Border x:Name="DownloadDim" Grid.RowSpan="2" Grid.ColumnSpan="2" Panel.ZIndex="40" Visibility="Collapsed" Background="#99090B10"/>

        <Border Grid.Row="1" Grid.Column="1" Background="#161A22" BorderBrush="#2A303C" BorderThickness="0,1,0,0" Padding="24,10">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="220"/><ColumnDefinition Width="1.4*" MinWidth="380"/><ColumnDefinition Width="*" MinWidth="140"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="50" Height="50" CornerRadius="8" Background="#3F3A75" ClipToBounds="True">
                        <Grid>
                            <TextBlock x:Name="PlayerArtInitial" Text="♫" FontSize="20" Foreground="#DED9FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="PlayerArtImage" Stretch="UniformToFill" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <StackPanel Margin="12,6,0,0"><TextBlock x:Name="PlayerTitle" Text="Choose something to play" Foreground="#F4F6FA" FontWeight="SemiBold" FontSize="13"/><TextBlock x:Name="PlayerArtist" Text="Your library is ready" Foreground="#9AA0AE" FontSize="11" Margin="0,4,0,0"/></StackPanel>
                </StackPanel>
                <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Content="◀│" Click="Previous_Click" Background="Transparent" Foreground="#B8BEC9" BorderThickness="0" Width="45" VerticalAlignment="Center"/>
                        <Button x:Name="PlayPauseButton" Content="▶" Click="PlayPause_Click" Style="{StaticResource PlayButtonStyle}" Margin="6,0" VerticalAlignment="Center"/>
                        <Button Content="│▶" Click="Next_Click" Background="Transparent" Foreground="#B8BEC9" BorderThickness="0" Width="45" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="ElapsedText" Text="0:00" Foreground="#777E8D" FontSize="10" VerticalAlignment="Center"/>
                        <Slider x:Name="ProgressSlider" Grid.Column="1" Minimum="0" Maximum="1" ValueChanged="ProgressSlider_ValueChanged" VerticalAlignment="Center" Foreground="#8B7CFF"/>
                        <TextBlock x:Name="RemainingText" Grid.Column="2" Text="-0:00" Foreground="#777E8D" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>
                </Grid>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="VOL" Foreground="#6E7584" FontSize="9" VerticalAlignment="Center" Margin="0,0,8,0"/><Slider x:Name="VolumeSlider" Width="95" Minimum="0" Maximum="1" Value="0.7" ValueChanged="VolumeSlider_ValueChanged"/></StackPanel>
            </Grid>
        </Border>
        <Canvas x:Name="IpodCanvas" Grid.Row="0" Grid.Column="1" Panel.ZIndex="12" IsHitTestVisible="True" ClipToBounds="True">
            <Button x:Name="IpodButton" Style="{StaticResource IpodButtonStyle}" Width="300" Height="300" Canvas.Right="-150" Canvas.Bottom="-150" Click="IpodButton_Click" AllowDrop="True" DragOver="IpodButton_DragOver" DragLeave="IpodButton_DragLeave" Drop="IpodButton_Drop" ToolTip="No iPod connected · Click to simulate connection">
                <Button.ContextMenu>
                    <ContextMenu x:Name="IpodMenu" Background="#1D222C" Foreground="#F4F6FA" BorderBrush="#363D4B" Opened="IpodMenu_Opened">
                        <MenuItem x:Name="IpodMenuHeader" Header="No iPod connected" IsEnabled="False" FontWeight="SemiBold"/>
                        <Separator/>
                        <MenuItem x:Name="IpodRescanItem" Header="Rescan for iPod" Click="RescanIpod_Click"/>
                        <Separator/>
                        <MenuItem Header="Sync all" Click="SyncIpod_Click"/>
                        <MenuItem Header="Sync music" Click="SyncIpod_Click"/>
                        <MenuItem Header="Sync changes" Click="SyncIpod_Click"/>
                        <MenuItem Header="Sync podcasts" Click="SyncIpod_Click"/>
                        <Separator/>
                        <MenuItem Header="Eject" Click="EjectIpod_Click"/>
                    </ContextMenu>
                </Button.ContextMenu>
                <Grid>
                    <Grid x:Name="RecordSpinGroup" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><RotateTransform x:Name="RecordRotation"/></Grid.RenderTransform>
                        <Ellipse x:Name="RecordDisc" Fill="#0B0B0E" Stroke="#000000" StrokeThickness="1"/>
                        <Ellipse Margin="14" Stroke="#171719" StrokeThickness="1"/>
                        <Ellipse Margin="22" Stroke="#202024" StrokeThickness="1"/>
                        <Ellipse Margin="32" Stroke="#171719" StrokeThickness="1"/>
                        <Ellipse Margin="44" Stroke="#202024" StrokeThickness="1"/>
                        <Ellipse Margin="58" Stroke="#171719" StrokeThickness="1"/>
                        <Ellipse Margin="74" Stroke="#202024" StrokeThickness="1"/>
                        <Ellipse Margin="92" Stroke="#171719" StrokeThickness="1"/>
                        <Ellipse>
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#22FFFFFF" Offset="0"/>
                                    <GradientStop Color="#00FFFFFF" Offset="0.42"/>
                                    <GradientStop Color="#00FFFFFF" Offset="0.58"/>
                                    <GradientStop Color="#18FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse x:Name="RecordLabel" Width="108" Height="108" Fill="#3A404B"/>
                        <Ellipse Width="34" Height="34" Fill="#0B0B0E"/>
                        <Ellipse Width="8" Height="8" Fill="#000000"/>
                    </Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.RenderTransform><TranslateTransform X="-74" Y="-74"/></StackPanel.RenderTransform>
                        <Border Width="34" Height="50" CornerRadius="5" Background="#D5DAE2" BorderBrush="#FFFFFF" BorderThickness="2" Padding="4">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="16"/><RowDefinition/></Grid.RowDefinitions><Border Background="#8EA6B2"><TextBlock Text="SINK" Foreground="#354252" FontSize="6" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Grid Grid.Row="1"><Ellipse Width="18" Height="18" Fill="#F7F8FA" Stroke="#A0A8B2"/><TextBlock Text="●" Foreground="#7C8490" FontSize="5" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Grid>
                        </Border>
                        <TextBlock x:Name="IpodStateText" Text="OFFLINE" FontSize="9" FontWeight="Bold" Foreground="#9AA1AF" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Button>
        </Canvas>
        <Border x:Name="ImportOverlay" Grid.RowSpan="2" Grid.ColumnSpan="2" Panel.ZIndex="50" Visibility="Collapsed" Margin="14" BorderBrush="#8B7CFF" BorderThickness="2" CornerRadius="18" Background="#EE11141B" IsHitTestVisible="False">
